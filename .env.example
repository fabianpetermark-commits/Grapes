# Ingyenes Unsplash API-kulcs (Access Key) a képtár-tallózáshoz.
# Regisztrálj itt: https://unsplash.com/developers
# Másold ezt a fájlt .env néven, és írd be a saját kulcsodat.
VITE_UNSPLASH_ACCESS_KEY=

VITE_GOOGLE_CLIENT_ID=
# A Google Picker API böngészős kulcsa (webhelyre és API-ra korlátozva).
# A Cloud-projektszám az OAuth kliensazonosító első része.
VITE_GOOGLE_PICKER_API_KEY=
# Külön, kizárólag Books API-ra és a Grapes webhelyére korlátozott kulcs.
VITE_GOOGLE_BOOKS_API_KEY=
VITE_GOOGLE_APP_ID=
VITE_EBOOK_TRANSFER_BROKER_URL=
# Csak a fájlonként engedélyezett EPUB-mentés éles, másolaton végzett tesztje után legyen true.
VITE_EBOOK_EPUB_WRITE_ENABLED=false

# Opcionális Open Food Facts kompatibilis proxy. Üresen a nyilvános API-t használja.
VITE_FOOD_API_URL=
# A fejlesztői menü pontos Google-fiókja. Build közben nyilvános klienskonfigurációvá válik.
VITE_DEVELOPER_EMAIL=projectsoundmodel@gmail.com
# Négy számjegyű UX-kapu. Statikus kliensben nem helyettesít szerveroldali jogosultságkezelést.
VITE_DEVELOPER_PIN=2026

# Dedicated Grapes Supabase TEST Auth; disabled by default.
# Only a publishable key belongs in a VITE_ variable. Never use service_role/secret.
VITE_GRAPES_TEST_AUTH_ENABLED=false
VITE_GRAPES_TEST_SUPABASE_URL=
VITE_GRAPES_TEST_SUPABASE_PUBLISHABLE_KEY=

# Health sync prototype is not integrated; keep OFF in normal TEST builds.
VITE_GRAPES_TEST_HEALTH_SYNC_ENABLED=false
